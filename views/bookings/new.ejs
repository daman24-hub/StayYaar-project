<% layout("layouts/boilerplate") %>

<div class="container mt-4 mb-5">
    <h2>Book: <%= listing.title %></h2>
    <div class="row">
        <div class="col-md-6">
            <div class="card p-3">
                <img src="<%= listing.image.url %>" class="img-fluid rounded mb-3" alt="">
                <h4><%= listing.location %>, <%= listing.country %></h4>
                <p><strong>₹<%= listing.price.toLocaleString("en-IN") %></strong> / night</p>
            </div>
        </div>

        <div class="col-md-6">
            <form action="/bookings/<%= listing._id %>" method="POST">
                <div class="mb-3">
                    <label for="booking[checkInDate]">Check-in</label>
                    <input type="date" class="form-control" name="booking[checkInDate]" required>
                </div>

                <div class="mb-3">
                    <label for="booking[checkOutDate]">Check-out</label>
                    <input type="date" class="form-control" name="booking[checkOutDate]" required>
                </div>

                <div class="mb-3">
                    <label for="booking[numberOfGuests]">Guests</label>
                    <input type="number" min="1" class="form-control" name="booking[numberOfGuests]" value="1" required>
                </div>

                <div class="mb-3">
                    <label for="booking[guestPhone]">Phone</label>
                    <input type="text" class="form-control" name="booking[guestPhone]" placeholder="Optional">
                </div>

                <div class="mb-3">
                    <label for="booking[specialRequests]">Special Requests</label>
                    <textarea class="form-control" name="booking[specialRequests]" rows="3"></textarea>
                </div>

                <button class="btn btn-danger w-100">Confirm Booking Request</button>
            </form>
        </div>
    </div>
</div>